rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usernames — anyone can read (for availability checking), owner can write
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Teams — members can read, team owner can write
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if request.auth != null
        && (
          request.auth.uid == resource.data.ownerId
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'memberIds'])
            && request.auth.uid in request.resource.data.memberIds
          )
        );
    }

    // User profile + stats — public read (powers leaderboard), owner-only write
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Forecasts (learn-page predictions) — private to owner
      match /forecasts/{marketId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Positions (card-page orders) — private to owner
      match /positions/{positionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
