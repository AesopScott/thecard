rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    match /usernames/{username} {
      allow read: if true;
      allow write: if isVerified() && request.resource.data.uid == request.auth.uid;
    }

    match /teams/{teamId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isVerified()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isVerified()
        && (
          request.auth.uid == resource.data.ownerId
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'memberIds'])
            && !(request.auth.uid in resource.data.memberIds)
            && request.auth.uid in request.resource.data.memberIds
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.resource.data.memberCount == resource.data.memberCount + 1
          )
        );
    }

    match /teamInvites/{code} {
      allow read: if isSignedIn();
      allow create: if isVerified()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.code == code
        && request.resource.data.active == true;
      allow update: if isVerified()
        && request.auth.uid == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'teamName', 'teamPhotoURL']);
    }

    match /friendLeagues/{leagueId} {
      allow read: if true;
      allow create: if isVerified()
        && leagueId.matches('friends-[0-9]{4,6}')
        && request.resource.data.keys().hasOnly(['leagueId', 'number', 'createdBy', 'isFree', 'hasPayouts', 'createdAt', 'updatedAt'])
        && request.resource.data.leagueId == leagueId
        && request.resource.data.number is string
        && leagueId == 'friends-' + request.resource.data.number
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.isFree == true
        && request.resource.data.hasPayouts == false;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && (
          isVerified()
          || request.resource.data.keys().hasOnly(['displayName', 'email', 'emailVerified', 'photoURL', 'updatedAt'])
        );
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && (
          isVerified()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'emailVerified', 'photoURL', 'updatedAt'])
        );

      allow update: if isVerified()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['theme', 'themeUpdatedAtMs', 'updatedAt'])
        && request.resource.data.theme in ['ticket', 'ice', 'mint', 'ink']
        && request.resource.data.themeUpdatedAtMs is number;

      match /forecasts/{marketId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if isVerified() && request.auth.uid == uid;
      }

      match /cardWatchlist/{watchlistId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create, update: if isVerified()
          && request.auth.uid == uid
          && watchlistId == 'default'
          && request.resource.data.marketIds is list
          && request.resource.data.updatedAtMs is number;
        allow delete: if false;
      }

      match /positions/{positionId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if isVerified() && request.auth.uid == uid;
      }

      match /settledPositions/{positionId} {
        allow read: if true;
        allow write: if isVerified() && request.auth.uid == uid;
      }

      match /betHistory/{betId} {
        allow read: if true;
        allow create: if isVerified()
          && request.auth.uid == uid
          && request.resource.data.leagueId is string
          && request.resource.data.marketId is string
          && request.resource.data.marketTitle is string
          && request.resource.data.side in ['yes', 'no']
          && request.resource.data.amountUsd is number
          && request.resource.data.contracts is number
          && request.resource.data.averagePrice is number
          && request.resource.data.placedAtMs is number;
        allow update, delete: if false;
      }

      match /perfectTenEntries/{contestId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create: if isVerified()
          && request.auth.uid == uid
          && request.resource.data.contestId == contestId
          && request.resource.data.isSubmitted in [true, false];
        allow update: if isVerified()
          && request.auth.uid == uid
          && resource.data.isSubmitted != true
          && request.resource.data.contestId == contestId
          && request.resource.data.isSubmitted in [true, false];
      }

      match /blitzRuns/{dateId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create: if isVerified()
          && request.auth.uid == uid
          && request.resource.data.date == dateId
          && request.resource.data.picks is list
          && request.resource.data.times is list
          && request.resource.data.score is number
          && request.resource.data.correct is number
          && request.resource.data.avgTime is number
          && request.resource.data.bestStreak is number
          && request.resource.data.perfectRun is bool
          && request.resource.data.completedAtMs is number
          && request.resource.data.marketIds is list;
        allow update, delete: if false;
      }

      match /h2hRuns/{dateId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create: if isVerified()
          && request.auth.uid == uid
          && request.resource.data.date == dateId
          && request.resource.data.picks is list
          && request.resource.data.opponentPicks is map
          && request.resource.data.outcomes is map
          && (request.resource.data.confidenceMarketId == null || request.resource.data.confidenceMarketId is string)
          && request.resource.data.yourCorrect is number
          && request.resource.data.opponentCorrect is number
          && request.resource.data.yourScore is number
          && request.resource.data.opponentScore is number
          && request.resource.data.upsetHits is number
          && request.resource.data.swing is list
          && request.resource.data.result in ['win', 'loss', 'tie-win'];
        allow update, delete: if false;
      }

      match /liveRuns/{dateId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create: if isVerified()
          && request.auth.uid == uid
          && request.resource.data.date == dateId
          && request.resource.data.gameId is string
          && request.resource.data.picks is list
          && request.resource.data.outcomes is map
          && (request.resource.data.boostMarketId == null || request.resource.data.boostMarketId is string)
          && request.resource.data.riskMode in ['conservative', 'balanced', 'aggressive']
          && request.resource.data.score is number
          && request.resource.data.correct is number
          && request.resource.data.streak is number
          && request.resource.data.boostedCorrect is bool
          && request.resource.data.perfectTicket is bool
          && request.resource.data.isBust is bool
          && request.resource.data.insuranceBadge is bool
          && request.resource.data.completedAtMs is number;
        allow update, delete: if false;
      }

      match /leagueMemberships/{leagueId} {
        allow read: if true;
        allow create: if isVerified()
          && request.auth.uid == uid
          && request.resource.data.leagueId == leagueId
          && request.resource.data.seasonId == leagueId
          && request.resource.data.startingBankroll is number
          && request.resource.data.currentBankroll is number
          && request.resource.data.betCount is number
          && request.resource.data.isBust is bool
          && request.resource.data.joinedAtMs is number;
        allow update: if isVerified()
          && request.auth.uid == uid
          && resource.data.leagueId == leagueId
          && request.resource.data.leagueId == leagueId
          && request.resource.data.seasonId == resource.data.seasonId
          && request.resource.data.startingBankroll == resource.data.startingBankroll
          && request.resource.data.joinedAtMs == resource.data.joinedAtMs
          && request.resource.data.currentBankroll is number
          && request.resource.data.betCount is number
          && request.resource.data.isBust is bool;
        allow delete: if false;
      }

      match /seasonMemberships/{leagueId} {
        allow read: if true;
        allow create: if isVerified()
          && request.auth.uid == uid
          && request.resource.data.leagueId == leagueId
          && request.resource.data.seasonId is string
          && request.resource.data.startingBankroll is number
          && request.resource.data.currentBankroll is number
          && request.resource.data.betCount is number
          && request.resource.data.isBust is bool
          && request.resource.data.joinedAtMs is number;
        allow update: if isVerified()
          && request.auth.uid == uid
          && resource.data.leagueId == leagueId
          && request.resource.data.leagueId == leagueId
          && request.resource.data.seasonId == resource.data.seasonId
          && request.resource.data.startingBankroll == resource.data.startingBankroll
          && request.resource.data.joinedAtMs == resource.data.joinedAtMs
          && request.resource.data.currentBankroll is number
          && request.resource.data.betCount is number
          && request.resource.data.isBust is bool;
        allow delete: if false;
      }
    }

    match /blitzLeaderboards/{dateId}/entries/{uid} {
      allow read: if true;
      allow create: if isVerified()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && (request.resource.data.photoURL == null || request.resource.data.photoURL is string)
        && request.resource.data.score is number
        && request.resource.data.correct is number
        && request.resource.data.avgTime is number
        && request.resource.data.bestStreak is number
        && request.resource.data.perfectRun is bool
        && request.resource.data.completedAtMs is number;
      allow update, delete: if false;
    }

    match /h2hLeaderboards/{dateId}/entries/{uid} {
      allow read: if true;
      allow create: if isVerified()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && (request.resource.data.photoURL == null || request.resource.data.photoURL is string)
        && request.resource.data.result in ['win', 'loss', 'tie-win']
        && request.resource.data.yourCorrect is number
        && request.resource.data.opponentCorrect is number
        && request.resource.data.yourScore is number
        && request.resource.data.opponentScore is number
        && request.resource.data.margin is number
        && request.resource.data.upsetHits is number
        && request.resource.data.completedAtMs is number;
      allow update, delete: if false;
    }

    match /liveLeaderboards/{dateId}/entries/{uid} {
      allow read: if true;
      allow create: if isVerified()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && (request.resource.data.photoURL == null || request.resource.data.photoURL is string)
        && request.resource.data.score is number
        && request.resource.data.correct is number
        && request.resource.data.pickCount is number
        && request.resource.data.streak is number
        && request.resource.data.boostedCorrect is bool
        && request.resource.data.perfectTicket is bool
        && request.resource.data.isBust is bool
        && request.resource.data.completedAtMs is number;
      allow update, delete: if false;
    }

    match /seasonLeaderboards/{leagueId}/entries/{uid} {
      allow read: if true;
      allow create, update: if isVerified()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.displayName is string
        && request.resource.data.avatarInitial is string
        && request.resource.data.bankroll is number
        && request.resource.data.betCount is number
        && request.resource.data.isBust is bool
        && request.resource.data.seasonId is string
        && request.resource.data.joinedAtMs is number;
      allow delete: if false;
    }

    match /freeLeagueLeaderboards/{leagueId}/entries/{uid} {
      allow read: if true;
      allow create, update: if isVerified()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.displayName is string
        && request.resource.data.bankroll is number
        && request.resource.data.shadowWinnings is number
        && request.resource.data.betCount is number
        && request.resource.data.isBust is bool
        && request.resource.data.joinedAtMs is number;
      allow delete: if false;
    }
  }
}
