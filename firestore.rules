rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    match /usernames/{username} {
      allow read: if true;
      allow write: if isVerified() && request.resource.data.uid == request.auth.uid;
    }

    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create: if isVerified()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isVerified()
        && (
          request.auth.uid == resource.data.ownerId
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'memberIds'])
            && request.auth.uid in request.resource.data.memberIds
          )
        );
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && (
          isVerified()
          || request.resource.data.keys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt'])
        );
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && (
          isVerified()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt'])
        );

      match /forecasts/{marketId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if isVerified() && request.auth.uid == uid;
      }

      match /positions/{positionId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if isVerified() && request.auth.uid == uid;
      }
    }
  }
}
