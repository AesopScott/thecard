rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usernames — anyone can read (for availability checking), owner can write
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Teams — members can read, team owner can write
    match /teams/{teamId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow write: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // User profile + stats — public read (powers leaderboard), owner-only write
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Forecasts (learn-page predictions) — private to owner
      match /forecasts/{marketId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Positions (card-page orders) — private to owner
      match /positions/{positionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}

// Storage rules (avatars, team photos)
service firebase.storage {
  match /b/{bucket}/o {
    // User avatars — owner can read/write
    match /avatars/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Team photos — team members can read, owner can write
    match /team-photos/{teamId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
