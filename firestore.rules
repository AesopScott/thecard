rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile + stats — public read (powers leaderboard), owner-only write
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Forecasts (learn-page predictions) — private to owner
      match /forecasts/{marketId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Positions (card-page orders) — private to owner
      match /positions/{positionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
